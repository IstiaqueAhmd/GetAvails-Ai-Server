# OpenAI API Configuration
OPENAI_API_KEY=
# Optional chat tuning
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=1000
# Max number of prior messages sent to the model per request
CHAT_MAX_HISTORY_MESSAGES=20

# Database Configuration
DATABASE_URL=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins (no wildcard with credentials)
# e.g. https://app.getavails.com,https://getavails.com
ALLOWED_ORIGINS=http://localhost:3000

# Authentication Configuration
# Generate a strong random value, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200


#check if production/development environment
ENVIRONMENT=production

# Public Chat Configuration (landing page agent - no RAG)
PUBLIC_CHAT_SYSTEM_PROMPT=